# 本体的设置（装好后在 $DSH_HOME/companion/.env 里改，改完重启 DSH）。
# 别的插件的开关写在各自的 README 里，照着加到这个文件后面就行。

# ── QQ 连接（NapCat 的正向 WebSocket）──
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# ── 谁能找它：QQ 号、群号，逗号隔开；都空着就谁都不理 ──
ALLOWED_QQ=
ALLOWED_GROUPS=
# 主人（主动消息、电脑上的事都只找这个人；也可以单独写 PC_OWNER）
PROACTIVE_QQ=

# ── 名字：功能页、默认人设里用；群里叫这些词也能把它叫出来 ──
BOT_NAME=小伴
WAKE_WORDS=

# ── 模型 ──
# 默认用 DSH 自己登录好的账号；想单独用一个 API Key 就填这里
DEEPSEEK_API_KEY=
# 白名单里的人能让它做到什么程度：read-only / workspace-write / danger-full-access
DSH_PERMISSION_MODE=

# ── 像人的节奏（数字项别留空：空着会被当成 0，等于关掉）──
MERGE_MS=5000
TYPING_MS_PER_CHAR=130
TYPO_PROB=0.04
SLEEP_START=1
SLEEP_END=7
SLEEP_DELAY_PROB=0.5

# ── 看懂发来的视频：要“听”里面说了啥，得有本地的 faster-whisper 模型（文件夹里有 base\model.bin），不会自己下载 ──
WHISPER_MODEL_DIR=
