  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "index.js",
    "module.mjs",
    "pc.mjs",
    "qqmusic.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzs6615/dsh-companion-plugins.git",
    "directory": "packages/pc"
  },
  "keywords": [
    "dsh",
